<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-screen incoming call UI. Built from framework widgets only (no AppCompat,
  ConstraintLayout or Material dependency) so it compiles with the exact same
  dependency set this module already had.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/zastro_call_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/zastro_bg_incoming_call"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingTop="72dp"
        android:paddingRight="24dp">

        <!-- App identity, so the user knows which app is ringing. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/zastro_app_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:layout_marginRight="8dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <TextView
                android:id="@+id/zastro_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/zastro_call_secondary_text"
                android:textSize="15sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp">

            <ImageView
                android:id="@+id/zastro_caller_avatar"
                android:layout_width="@dimen/zastro_call_avatar_size"
                android:layout_height="@dimen/zastro_call_avatar_size"
                android:background="@drawable/zastro_bg_avatar_circle"
                android:contentDescription="@null"
                android:padding="@dimen/zastro_call_avatar_padding"
                android:scaleType="fitCenter"
                android:src="@drawable/zastro_ic_avatar_placeholder" />

            <!-- Host app launcher icon, bottom-right of the photo, WhatsApp style.
                 Hidden if the icon cannot be resolved. -->
            <ImageView
                android:id="@+id/zastro_app_badge"
                android:layout_width="@dimen/zastro_call_badge_size"
                android:layout_height="@dimen/zastro_call_badge_size"
                android:layout_gravity="bottom|end|right"
                android:background="@drawable/zastro_bg_app_badge"
                android:contentDescription="@null"
                android:padding="@dimen/zastro_call_badge_padding"
                android:scaleType="fitCenter"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/zastro_caller_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/zastro_unknown_caller"
            android:textColor="@color/zastro_call_primary_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- "Incoming voice call · 12:58 pm" (the time is dropped if unknown). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/zastro_call_type_icon"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_marginEnd="7dp"
                android:layout_marginRight="7dp"
                android:contentDescription="@null"
                android:src="@drawable/zastro_ic_call_type_voice" />

            <TextView
                android:id="@+id/zastro_call_type_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/zastro_incoming_call"
                android:textColor="@color/zastro_call_secondary_text"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingLeft="36dp"
        android:paddingRight="36dp"
        android:paddingBottom="72dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/zastro_btn_decline"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/zastro_bg_decline_button"
                android:contentDescription="@string/zastro_decline"
                android:scaleType="centerInside"
                android:src="@drawable/zastro_ic_call_decline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/zastro_decline"
                android:textColor="@color/zastro_call_secondary_text"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/zastro_btn_answer"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/zastro_bg_answer_button"
                android:contentDescription="@string/zastro_answer"
                android:scaleType="centerInside"
                android:src="@drawable/zastro_ic_call_answer" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/zastro_answer"
                android:textColor="@color/zastro_call_secondary_text"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
